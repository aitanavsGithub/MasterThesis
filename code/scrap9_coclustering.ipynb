    "    [],\n",
    "    linewidth=3\n",
    ")\n",
    "\n",
    "# -------------------------\n",
    "# CLICK interaction\n",
    "# -------------------------\n",
    "cursor = mplcursors.cursor([sc], hover=False)\n",
    "\n",
    "@cursor.connect(\"add\")\n",
    "def on_click(sel):\n",
    "\n",
    "    idx = sel.index\n",
    "    wf = umap_df['waveform'].iloc[idx]\n",
    "\n",
    "    # update highlighted waveform\n",
    "    highlight_line.set_data(\n",
    "        np.arange(len(wf)),\n",
    "        wf\n",
    "    )\n",
    "\n",
    "    # match waveform color\n",
