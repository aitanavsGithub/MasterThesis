    "# Step 1: try different smoothing methods and different window sizes\n",
    "from scipy.ndimage import gaussian_filter1d\n",
    "from scipy.signal import savgol_filter\n",
    "\n",
    "all_wf_corr\n",
    "\n",
    "def moving_average(x, window=5):\n",
    "    kernel = np.ones(window) / window\n",
    "    return np.convolve(x, kernel, mode='same')\n",
    "\n",
    "# moving average\n",
    "smoothed_ma = np.apply_along_axis(moving_average, axis=1, arr=all_wf_corr)\n",
    "# gaussian filter\n",
    "smoothed_gf = np.apply_along_axis(lambda x: gaussian_filter1d(x, sigma=1), axis=1, arr=all_wf_corr)\n",
    "# Savitzky Golay filter\n",
    "smoothed_sg = savgol_filter(all_wf_corr,window_length=11,polyorder=3,axis=-1)\n",
    "\n",
    "# list of window sizes\n",
    "window_sizes = [3, 5, 7, 11]\n",
    "\n",
    "fig, axes = plt.subplots(len(window_sizes), 3, figsize=(12, 15))\n",
    "\n",
    "for i, window in enumerate(window_sizes):\n",
    "    # moving average\n",
    "    smoothed_ma = np.apply_along_axis(lambda x: moving_average(x, window=window), axis=1, arr=all_wf_corr)\n",
    "    axes[i, 0].plot(smoothed_ma.T, alpha=0.05)\n",
    "    axes[i, 0].set_title(f'Moving Average (window={window})')\n",
    "    \n",
    "    # gaussian filter\n",
    "    smoothed_gf = np.apply_along_axis(lambda x: gaussian_filter1d(x, sigma=window/2), axis=1, arr=all_wf_corr)\n",
    "    axes[i, 1].plot(smoothed_gf.T, alpha=0.05)\n",
    "    axes[i, 1].set_title(f'Gaussian Filter (sigma={window/2})')\n",
    "    \n",
    "    # Savitzky Golay filter\n",
    "    smoothed_sg = savgol_filter(all_wf_corr, window_length=window if window % 2 == 1 else window+1, polyorder= 3 if window > 3 else window-1, axis=-1)\n",
    "    axes[i, 2].plot(smoothed_sg.T, alpha=0.05)\n",
    "    axes[i, 2].set_title(f'Savitzky-Golay (window={window})')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n"
   ]
  },
