   "source": [
    "### Goal: \n",
    "Co-cluster the excitatory with the dissorg cells"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "e1c78ad8",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "'d:\\\\MasterThesis\\\\code'"
      ]
     },
     "execution_count": 1,
