    "    )\n",
    "axes[0].legend()\n",
    "axes[0].set_title(\"UMAP\")\n",
    "\n",
    "# -------------------------\n",
    "# 2) Background waveforms\n",
    "# -------------------------\n",
    "for i, wf in enumerate(umap_df['waveform']):\n",
    "    axes[1].plot(\n",
    "        wf,\n",
    "        color=umap_df['cluster_color'].iloc[i],\n",
    "        alpha=0.05,\n",
    "        linewidth=1\n",
    "    )\n",
    "\n",
    "axes[1].set_title(\"Waveforms\")\n",
    "\n",
    "# -------------------------\n",
    "# Highlighted waveform\n",
